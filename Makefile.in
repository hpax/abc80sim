#!/usr/bin/make -R -r

#
# Main makefile for ABC80/800 simulator
#

top_srcdir      := @top_srcdir@
srcdir          := @srcdir@
include $(top_srcdir)/common.mk

.SECONDARY:
.DELETE_ON_ERROR:

GENC = baudtospeed.c helptxt.c
SRCS = abc80.c clock.c sdlscrn.c fgcolor.c screenshot.c \
	z80.c z80irq.c as.c mem.c abcmem.c abcio.c debug.c \
	abcfont.c disk.c rtc.c simprint.c print.c fileop.c z80dasm.c \
	nstime.c hostfile.c console.c cas.c abcfile.c filelist.c \
	trace.c sysload.c \
	abcprintd.c serial.c netopen.c \
	random.c sysrand.c $(GENC)

OBJS = $(patsubst %.c,%.$(O),$(SRCS))

CLIB = clib.$(A)
ROMLIB = roms/roms.$(A)

SRCDIRS = . clib

TARGETS = @TARGETS@

all: $(TARGETS)

install: all
	$(MKDIR) -p $(INSTALLROOT)$(bindir)
	$(INSTALL_PROGRAM) $(TARGETS) $(INSTALLROOT)$(bindir)
	$(MKDIR) -p $(INSTALLROOT)$(mandir)/man1
	$(INSTALL_DATA) abc80.man $(INSTALLROOT)$(mandir)/man1/abc80.1

abc80$(X): $(OBJS) $(ROMLIB) $(CLIB)
	$(CC) $(LDFLAGS) -o abc80$(X) $^ $(LIBS)

abc80win$(X): winwrap.c
	$(CC) $(LDFLAGS) -mwindows -municode -D_UNICODE -o abc80win$(X) $^

z80dis$(X): z80dis.$(O) z80dasm.$(O)
	$(CC) $(LDFLAGS) -o z80dis$(X) $^

.PHONY: roms
roms:
	$(MAKE) -C roms

$(ROMLIB): roms

%.c: %.rom bin2c.pl
	$(PERL) bin2c.pl $< > $@ || ( rm -f $@ ; false )

$(CLIB): $(LIBOBJS)
	rm -f $@
	$(AR) cq $@ $^
	$(RANLIB) $@

helptxt.c: HELP.txt txt2c.sed
	$(SED) -f txt2c.sed $< > $@

# Note: it is OK for the cpp invocation to fail, which is a good thing
# because it uses nonstandard constructs.
baudtospeed.c: termios.c baudtospeed.sh
	( $(CC) $(CFLAGS) -Wp,-dM -E termios.c || true ) \
		| sh baudtospeed.sh > "$@"

.PHONY: roms
roms:
	$(MAKE) -C roms

.PHONY: asm
asm: asmsrc
	$(MAKE) all

.PHONY: asmsrc
asmsrc:
	$(MAKE) -C asmsrc

CLEAN_SUBDIRS = roms

clean: clean.common
	$(RM_F) $(TARGETS) core $(GENC) $(CLIB)

spotless: spotless.common
	$(RM_F) configure config.status config.log config/config.h
	$(RM_RF) autoconf/aclocal.m4 autom4te.cache

-include .*.d clib/.*.d
