#
# Makefile for the ABC80 emulator
#

top_srcdir      = @top_srcdir@
srcdir          = @srcdir@
VPATH           = @srcdir@
prefix          = @prefix@
exec_prefix     = @exec_prefix@
bindir          = @bindir@
mandir          = @mandir@
datarootdir     = @datarootdir@

CC		= @CC@
CPPFLAGS	= @CPPFLAGS@ @DEFS@ -I.
CFLAGS		= $(CPPFLAGS) @CFLAGS@
LDFLAGS		= $(CFLAGS) @LDFLAGS@
LIBS		= @LIBS@

MKDIR		= mkdir
PERL		= perl
RM_F		= rm -f

# For Windows/MinGW use obj and .exe
O		= @OBJEXT@
X		= @EXEEXT@

.SUFFIXES:
.SUFFIXES: .c .h .$(O) .bin $(X) .i .s .asm

GENC = $(patsubst %.rom,%.c,$(wildcard roms/*.rom))
SRCS = abc80.c clock.c sdlscrn.c screenshot.c z80.c abcmem.c abcio.c \
       abcfont.c disk.c rtc.c abcprint.c print.c fileop.c z80dis.c \
       nstime.c hostfile.c console.c cas.c abcfile.c clib/asprintf.c $(GENC)
HDRS = clock.h screen.h z80.h patchlevel.h screenshot.h abcio.h \
       abcprintd.h rom.h nstime.h hostfile.h \
       compiler.h clib/inttypes.h config/config.h

OBJS = $(patsubst %.c,%.$(O),$(SRCS))

all: abc80$(X)

install: abc80$(X)
	$(MKDIR) -p $(INSTALLROOT)$(bindir)
	$(INSTALL_PROGRAM) abc80$(X) $(INSTALLROOT)$(bindir)
	$(MKDIR) -p $(INSTALLROOT)$(mandir)/man1
	$(INSTALL_DATA) abc80.man $(INSTALLROOT)$(mandir)/man1/abc80.1

abc80$(X): $(OBJS)
	$(CC) $(LDFLAGS) -o abc80$(X) $(OBJS) $(LIBS)

.PRECIOUS: %.c
%.c: %.rom bin2c.pl
	$(PERL) bin2c.pl $< > $@ || ( rm -f $@ ; false )

.PRECIOUS: %.o
%.o: %.c $(HDRS)
	$(CC) $(CFLAGS) -c -o $@ $<

%.i: %.c $(HDRS)
	$(CC) $(CFLAGS) -E -o $@ $<

%.s: %.c $(HDRS)
	$(CC) $(CFLAGS) -S -o $@ $<

clean:
	$(RM_F) abc80$(X) *.$(O) *~ core *.lst *.i *.s *~
	$(RM_F) roms/*.c
