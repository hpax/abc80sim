#
# Makefile for the ABC80 emulator
#

top_srcdir      = @top_srcdir@
srcdir          = @srcdir@
VPATH           = @srcdir@
prefix          = @prefix@
exec_prefix     = @exec_prefix@
bindir          = @bindir@
mandir          = @mandir@
datarootdir     = @datarootdir@

CC		= @CC@
AUTODEPS        = @AUTODEPS@
CPPFLAGS	= @CPPFLAGS@ @DEFS@ -I.
CFLAGS		= $(CPPFLAGS) @CFLAGS@
LDFLAGS		= $(CFLAGS) @LDFLAGS@
LIBS		= @LIBS@

MKDIR		= mkdir
PERL		= perl
SED             = sed
RM_F		= rm -f

# For Windows/MinGW use obj and .exe
O		= @OBJEXT@
X		= @EXEEXT@

.SUFFIXES:
.SUFFIXES: .c .h .$(O) .bin $(X) .i .s .asm

.SECONDARY:
.DELETE_ON_ERROR:

GENC = $(patsubst %.rom,%.c,$(wildcard roms/*.rom)) baudtospeed.c helptxt.c
SRCS = abc80.c clock.c sdlscrn.c fgcolor.c screenshot.c \
	z80.c z80irq.c as.c mem.c abcmem.c abcio.c debug.c \
	abcfont.c disk.c rtc.c simprint.c print.c fileop.c z80dasm.c \
	nstime.c hostfile.c console.c cas.c abcfile.c filelist.c \
	trace.c sysload.c \
	abcprintd.c serial.c netopen.c \
	random.c sysrand.c \
	clib/asprintf.c clib/localtime.c $(GENC)

OBJS = $(patsubst %.c,%.$(O),$(SRCS))

SRCDIRS = . clib roms

TARGETS = @TARGETS@

all: $(TARGETS)

install: all
	$(MKDIR) -p $(INSTALLROOT)$(bindir)
	$(INSTALL_PROGRAM) $(TARGETS) $(INSTALLROOT)$(bindir)
	$(MKDIR) -p $(INSTALLROOT)$(mandir)/man1
	$(INSTALL_DATA) abc80.man $(INSTALLROOT)$(mandir)/man1/abc80.1

abc80$(X): $(OBJS)
	$(CC) $(LDFLAGS) -o abc80$(X) $(OBJS) $(LIBS)

abc80win$(X): winwrap.c
	$(CC) $(LDFLAGS) -mwindows -municode -D_UNICODE -o abc80win$(X) $^

z80dis$(X): z80dis.$(O) z80dasm.$(O)
	$(CC) $(LDFLAGS) -o z80dis$(X) $^

%.c: %.rom bin2c.pl
	$(PERL) bin2c.pl $< > $@ || ( rm -f $@ ; false )

%.$(O): %.c $(HDRS)
	$(CC) $(AUTODEPS) $(CFLAGS) -DMODULE='$(*F)' -c -o $@ $<

%.i: %.c $(HDRS)
	$(CC) $(AUTODEPS) $(CFLAGS) -DMODULE='$(*F)' -E -o $@ $<

%.s: %.c $(HDRS)
	$(CC) $(AUTODEPS) $(CFLAGS) -DMODULE='$(*F)' -S -o $@ $<

helptxt.c: HELP.txt txt2c.sed
	$(SED) -f txt2c.sed $< > $@

# Note: it is OK for the cpp invocation to fail, which is a good thing
# because it uses nonstandard constructs.
baudtospeed.c: termios.c baudtospeed.sh
	( $(CC) $(CFLAGS) -Wp,-dM -E termios.c || true ) \
		| sh baudtospeed.sh > "$@"

.PHONY: roms
roms:
	$(MAKE) -C roms

.PHONY: asm
asm: asmsrc
	$(MAKE) all

.PHONY: asmsrc
asmsrc:
	$(MAKE) -C asmsrc

clean:
	for d in $(SRCDIRS); do \
		$(RM_F) $$d/*.$(O) $$d/.*.d $$d/*.lst $$d/*.i $$d/*.s \
			$$d/*.lst ; \
	done
	$(RM_F) $(TARGETS) core $(GENC) roms/*.c

spotless: clean
	for d in $(SRCDIRS); do \
		$(RM_F) $$d/*~ $$d/'.#'* $$d/'#'* $$d/*.bak $$d/*.$$$$$$ ; \
	done
	$(RM_F) configure config.status config.log Makefile config/config.h
	$(RM_F) autoconf/aclocal.m4 autom4te.cache

-include .*.d clib/.*.d roms/.*.d
